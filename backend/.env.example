PORT=5000
NODE_ENV=production

# Frontend Vercel Origin for CORS configuration
# Local Development: http://localhost:5173
# Production (Render): https://quiz-master-green-six.vercel.app
FRONTEND_URL=https://quiz-master-green-six.vercel.app

# Database (Supabase PostgreSQL Client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
